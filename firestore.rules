rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function activeUser() {
      return signedIn() &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.moderationStatus != 'suspended'
        );
    }

    function conversationParticipant(data) {
      return data.participants is list &&
        request.auth.uid in data.participants;
    }

    match /users/{userId} {
      allow read: if admin() || (activeUser() && request.auth.uid == userId);

      allow create: if activeUser() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'wishlistIds',
          'name',
          'college',
          'department',
          'academicYear'
        ]);

      allow update: if activeUser() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'wishlistIds',
          'name',
          'college',
          'department',
          'academicYear'
        ]);

      allow delete: if false;
    }

    match /listings/{listingId} {
      allow read: if activeUser();
      allow create: if activeUser() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if activeUser() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if activeUser() &&
        resource.data.ownerId == request.auth.uid;
    }

    match /requests/{requestId} {
      // A buyer transaction reads its deterministic request ID before
      // creating it. Permit authenticated reads of a missing document;
      // existing request documents remain private to their participants.
      allow get: if activeUser() &&
        (
          !exists(/databases/$(database)/documents/requests/$(requestId)) ||
          resource.data.requesterId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        );

      allow list: if activeUser() &&
        (
          resource.data.requesterId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        );

      allow create: if activeUser() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.ownerId != request.auth.uid &&
        exists(/databases/$(database)/documents/listings/$(request.resource.data.resourceId)) &&
        get(/databases/$(database)/documents/listings/$(request.resource.data.resourceId))
          .data.ownerId == request.resource.data.ownerId;

      allow update: if activeUser() &&
        resource.data.ownerId == request.auth.uid &&
        resource.data.status == 'Pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['Accepted', 'Rejected'] &&
        (
          request.resource.data.status == 'Rejected' ||
          (
            existsAfter(/databases/$(database)/documents/conversations/$(requestId)) &&
            getAfter(/databases/$(database)/documents/conversations/$(requestId))
              .data.requestId == requestId &&
            getAfter(/databases/$(database)/documents/conversations/$(requestId))
              .data.status == 'active'
          )
        );

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if admin() ||
        (activeUser() && conversationParticipant(resource.data));

      allow create: if activeUser() &&
        request.resource.data.requestId == conversationId &&
        request.resource.data.status == 'active' &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.buyerId != request.resource.data.sellerId &&
        request.resource.data.participants.hasAll([
          request.resource.data.buyerId,
          request.resource.data.sellerId
        ]) &&
        request.auth.uid in request.resource.data.participants &&
        existsAfter(/databases/$(database)/documents/requests/$(conversationId)) &&
        getAfter(/databases/$(database)/documents/requests/$(conversationId))
          .data.status == 'Accepted' &&
        getAfter(/databases/$(database)/documents/requests/$(conversationId))
          .data.ownerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/requests/$(conversationId))
          .data.requesterId == request.resource.data.buyerId;

      allow update: if admin() ||
        (
          activeUser() &&
          conversationParticipant(resource.data) &&
          (
            (
              resource.data.status == 'active' &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lastMessage', 'updatedAt']) &&
              request.resource.data.lastMessage is string &&
              request.resource.data.lastMessage.size() <= 4000
            ) ||
            (
              resource.data.status == 'active' &&
              request.resource.data.status == 'reported' &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status',
                  'reportedBy',
                  'reportedUserId',
                  'reportId',
                  'updatedAt'
                ]) &&
              request.resource.data.reportedBy == request.auth.uid &&
              request.resource.data.reportedUserId in resource.data.participants &&
              request.resource.data.reportedUserId != request.auth.uid &&
              existsAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)) &&
              getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId))
                .data.conversationId == conversationId &&
              getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId))
                .data.reporterId == request.auth.uid
            )
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if admin() ||
          (
            activeUser() &&
            conversationParticipant(
              get(/databases/$(database)/documents/conversations/$(conversationId)).data
            )
          );

        allow create: if activeUser() &&
          get(/databases/$(database)/documents/conversations/$(conversationId))
            .data.status == 'active' &&
          conversationParticipant(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          ) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000;

        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if activeUser() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.reason is string &&
        request.resource.data.reportedUserId != request.auth.uid &&
        exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
          .data.status == 'active' &&
        request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data.participants &&
        request.resource.data.reportedUserId in get(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data.participants;

      allow read: if admin();
      allow update: if admin() &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'reviewedBy',
            'reviewedAt'
          ]) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'reviewedBy',
            'reviewedAt',
            'action',
            'actionAt'
          ])
        );
      allow delete: if false;
    }
  }
}
